{
  "expo": {
    "name": "LOGITERRE",
    "slug": "logiterre",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#2e368e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.logiterre",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin d'accéder à la caméra pour scanner les QR codes des badges.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#00000000",
        "translucent": true
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.logiterre",
      "versionCode": 12,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LOGITERRE to access your camera"
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "49d9e8d2-d8fa-4666-9e20-64d5b467c63d"
      }
    },
    "owner": "mzlouafi"
  }
}
